// Path tracing integrator, shared by the software (main.glsl) and hardware (main_hw.glsl)
// entry points. Expects common.glsli, brdfs.glsli and a trace_*.glsli providing
// trace_closest() / trace_any() to be included first.

// PIXEL_ID must be defined by the entry point (compute invocation or ray launch id).

// ----------------------------------- SCENE QUERIES -----------------------------------

vec3 sample_sky(vec3 d) {
    if (d.y >= 0.0) {
        return mix(frame.sky_horizon.rgb, frame.sky_top.rgb, sqrt(d.y));
    }
    return mix(frame.sky_horizon.rgb, frame.ground.rgb, sqrt(min(1.0, -d.y * 4.0)));
}

float triangle_world_area(const Instance inst, const Triangle tri) {
    vec3 e1 = xform_vector(inst.o2w, tri.e1.xyz);
    vec3 e2 = xform_vector(inst.o2w, tri.e2.xyz);
    return 0.5 * length(cross(e1, e2));
}

ShadingInfo get_shading(const Ray ray, const Hit h) {
    ShadingInfo s;
    Instance inst = instances[h.instance];
    Triangle tri = triangles[h.triangle];
    TriangleData td = triangle_data[h.triangle];
    Material m = materials[instance_materials[inst.material_offset + td.surface]];

    float u = h.bary.x;
    float v = h.bary.y;
    float w = 1.0 - u - v;

    s.position = ray.o + ray.d * h.t;
    s.out_dir = -ray.d;

    vec3 ng = normalize(xform_normal(inst.w2o, cross(tri.e1.xyz, tri.e2.xyz)));
    vec3 ns = normalize(xform_normal(inst.w2o, td.n0 * w + td.n1.xyz * u + td.n2.xyz * v));
    if (any(isnan(ns)) || dot(ns, ns) < 0.5) ns = ng;
    if (dot(ng, s.out_dir) < 0.0) { // back face: flip both normals towards the viewer
        ng = -ng;
        ns = -ns;
    }
    // Shading normals can point away from the viewer near silhouettes; fall back to the geometric one.
    if (dot(ns, s.out_dir) < 1e-3) ns = ng;
    s.geo_normal = ng;
    s.normal = ns;
    s.lambert_out = max(dot(ns, s.out_dir), 1e-4);

    vec2 uv = (td.uv0 * w + td.uv1 * u + td.uv2 * v) * m.uv_scale_offset.xy + m.uv_scale_offset.zw;
    vec3 albedo = m.albedo.rgb;
    if (m.albedo_texture >= 0) {
        albedo *= textureLod(albedo_textures, vec3(uv, float(m.albedo_texture)), 0.0).rgb;
    }

    s.emission = m.emission.rgb;
    s.emission_luminance = m.emission.a;
    s.fresnel_0 = mix(vec3(0.04), albedo, m.metallic);
    s.diffuse_albedo = albedo * (1.0 - m.metallic);
    float alpha = m.roughness * m.roughness;
    s.roughness = max(alpha, 0.01);
    s.area = triangle_world_area(inst, tri);
    return s;
}

vec3 offset_origin(const ShadingInfo s, vec3 dir) {
    // Push the origin off the surface on the side the new ray leaves through.
    float scale = 1e-4 * max(1.0, max(max(abs(s.position.x), abs(s.position.y)), abs(s.position.z)));
    return s.position + s.geo_normal * (dot(dir, s.geo_normal) >= 0.0 ? scale : -scale);
}

// ----------------------------------- PORTALS -----------------------------------

// Finds the closest portal whose front face the ray enters within (0, t_max).
bool intersect_portals(const Ray r, const float t_max, out float t_hit, out uint index) {
    t_hit = t_max;
    index = 0u;
    bool found = false;
    for (uint i = 0u; i < frame.portal_count; i++) {
        Portal p = portals[i];
        vec3 o = xform_point(p.w2l, r.o);
        vec3 d = xform_vector(p.w2l, r.d);
        if (d.z >= 0.0) continue; // only the front face (+z) is a portal
        float t = -o.z / d.z;
        if (t <= 1e-5 || t >= t_hit) continue;
        vec2 q = o.xy + d.xy * t;
        if (abs(q.x) > p.half_size.x || abs(q.y) > p.half_size.y) continue;
        t_hit = t;
        index = i;
        found = true;
    }
    return found;
}

struct SceneHit {
    bool found;            // a surface was hit
    bool absorbed;         // path ended inside a portal (unlinked or too many hops)
    bool crossed_portal;   // the segment passed through at least one portal
    float distance;        // total distance travelled including portal hops
    Hit hit;
};

// Traces `ray` through portals. On return `ray` is the final (possibly teleported) segment and
// `throughput` includes portal tints.
SceneHit trace_scene(inout Ray ray, inout vec3 throughput) {
    SceneHit sh;
    sh.found = false;
    sh.absorbed = false;
    sh.crossed_portal = false;
    sh.distance = 0.0;
    for (uint hop = 0u; hop <= frame.max_portal_hops; hop++) {
        bool found = trace_closest(ray, INF, sh.hit);
        if (frame.portal_count > 0u) {
            float pt;
            uint pi;
            if (intersect_portals(ray, found ? sh.hit.t : INF, pt, pi)) {
                Portal p = portals[pi];
                if (p.linked == 0u || hop == frame.max_portal_hops) {
                    sh.absorbed = true;
                    sh.distance += pt;
                    return sh;
                }
                vec3 pos = ray.o + ray.d * pt;
                ray.o = xform_point(p.teleport, pos);
                ray.d = normalize(xform_vector(p.teleport, ray.d));
                ray.o += ray.d * 1e-4;
                throughput *= p.tint.rgb;
                sh.distance += pt;
                sh.crossed_portal = true;
                continue;
            }
        }
        sh.found = found;
        if (found) sh.distance += sh.hit.t;
        return sh;
    }
    sh.absorbed = true;
    return sh;
}

// Shadow ray. Portal fronts block visibility: light is not sampled through portals.
bool occluded(const Ray r, const float t_max) {
    if (frame.portal_count > 0u) {
        float pt;
        uint pi;
        if (intersect_portals(r, t_max, pt, pi)) return true;
    }
    return trace_any(r, t_max);
}

// ----------------------------------- DIRECT LIGHTING -----------------------------------

float power_heuristic(float a, float b) {
    float a2 = a * a;
    float b2 = b * b;
    return a2 / max(a2 + b2, 1e-20);
}

// Probability (solid angle) that next event estimation picks the point `s` as seen from `from`.
float emissive_light_pdf(const ShadingInfo s, vec3 from) {
    if (frame.emissive_count == 0u || frame.emissive_total_power <= 0.0) return 0.0;
    vec3 to_light = s.position - from;
    float dist2 = dot(to_light, to_light);
    float cos_l = abs(dot(s.geo_normal, normalize(to_light)));
    if (cos_l < 1e-6) return 0.0;
    float pmf = s.emission_luminance * s.area / frame.emissive_total_power;
    return pmf * dist2 / (cos_l * s.area);
}

uint pick_emissive_triangle(float u) {
    uint lo = 0u;
    uint hi = frame.emissive_count - 1u;
    while (lo < hi) {
        uint mid = (lo + hi) >> 1u;
        if (emissive_triangles[mid].cdf < u) lo = mid + 1u;
        else hi = mid;
    }
    return lo;
}

vec3 sample_emissive(const ShadingInfo s, inout uint rng) {
    EmissiveTriangle light = emissive_triangles[pick_emissive_triangle(rand(rng))];
    Instance inst = instances[light.instance];
    Triangle tri = triangles[light.triangle];
    TriangleData td = triangle_data[light.triangle];
    Material m = materials[instance_materials[inst.material_offset + td.surface]];

    vec2 r = rand2(rng);
    if (r.x + r.y > 1.0) r = 1.0 - r;
    vec3 p = xform_point(inst.o2w, tri.v0.xyz + tri.e1.xyz * r.x + tri.e2.xyz * r.y);
    vec3 e1 = xform_vector(inst.o2w, tri.e1.xyz);
    vec3 e2 = xform_vector(inst.o2w, tri.e2.xyz);
    vec3 n_cross = cross(e1, e2);
    float area = 0.5 * length(n_cross);
    vec3 nl = n_cross / (2.0 * area);

    vec3 origin = offset_origin(s, p - s.position);
    vec3 to_light = p - origin;
    float dist2 = dot(to_light, to_light);
    float dist = sqrt(dist2);
    vec3 wi = to_light / dist;

    float cos_s = dot(s.normal, wi);
    float cos_l = abs(dot(nl, wi)); // emitters are two-sided
    if (cos_s <= 0.0 || cos_l < 1e-6 || dot(s.geo_normal, wi) <= 0.0) return vec3(0.0);

    float pmf = light.power / frame.emissive_total_power;
    float pdf_light = pmf * dist2 / (cos_l * area);
    if (!(pdf_light > 0.0)) return vec3(0.0);

    Ray shadow;
    shadow.o = origin;
    shadow.d = wi;
    if (occluded(shadow, dist * (1.0 - 1e-4))) return vec3(0.0);

    vec3 f = brdf(s, wi) * cos_s;
    float pdf_bsdf = get_brdf_density(s, wi);
    return f * m.emission.rgb * power_heuristic(pdf_light, pdf_bsdf) / pdf_light;
}

float godot_omni_attenuation(float dist, float range, float decay) {
    float nd = dist / max(range, 1e-4);
    nd *= nd;
    nd *= nd;
    nd = max(1.0 - nd, 0.0);
    nd *= nd;
    return nd * pow(max(dist, 1e-4), -decay);
}

vec3 sample_punctual(const ShadingInfo s, const PunctualLight light, inout uint rng) {
    vec3 wi;
    float dist;
    vec3 radiance;
    if (light.type == LIGHT_DIRECTIONAL) {
        vec3 l = -light.direction;
        if (light.radius > 0.0) { // soft shadows: sample a cone around the sun direction
            mat3 b = basis_from_normal(l);
            vec2 disk = sample_disk(rand2(rng)) * light.radius;
            l = normalize(b * vec3(disk, 1.0));
        }
        wi = l;
        dist = INF;
        radiance = light.color;
    } else {
        vec3 target = light.position;
        if (light.radius > 0.0) target += sample_sphere(rand2(rng)) * light.radius;
        vec3 to_light = target - s.position;
        dist = length(to_light);
        if (dist < 1e-5 || dist > light.range) return vec3(0.0);
        wi = to_light / dist;
        radiance = light.color * godot_omni_attenuation(dist, light.range, light.attenuation);
        if (light.type == LIGHT_SPOT) {
            float c = dot(-wi, light.direction);
            radiance *= smoothstep(light.spot_cos_outer, light.spot_cos_inner, c);
        }
    }
    float cos_s = dot(s.normal, wi);
    if (cos_s <= 0.0 || dot(s.geo_normal, wi) <= 0.0 || luminance(radiance) <= 0.0) return vec3(0.0);

    Ray shadow;
    shadow.o = offset_origin(s, wi);
    shadow.d = wi;
    if (occluded(shadow, dist == INF ? INF : dist * (1.0 - 1e-4))) return vec3(0.0);
    return brdf(s, wi) * cos_s * radiance;
}

// ----------------------------------- INTEGRATOR -----------------------------------

// What the camera ray saw first; drives temporal reprojection.
struct Primary {
    bool hit;
    vec3 normal;        // world normal at the first hit (after portals)
    float distance;     // distance along the (virtual, unfolded) camera ray; -1 for sky
    vec3 prev_position; // where this point was last frame, in world space
    bool has_prev;      // false for sky (reproject by direction instead)
    vec3 albedo;        // reflectance at the first hit (times portal tints), 1 for sky; for demodulation
};

vec3 clamp_contribution(vec3 c, uint depth) {
    if (depth == 0u || frame.firefly_clamp <= 0.0) return c;
    float l = luminance(c);
    return l > frame.firefly_clamp ? c * (frame.firefly_clamp / l) : c;
}

vec3 path_trace(Ray ray, inout uint rng, out Primary primary) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float prev_bsdf_pdf = 0.0;
    vec3 prev_position = ray.o;
    const vec3 camera_dir = ray.d;
    const vec3 camera_pos = ray.o;

    primary.hit = false;
    primary.normal = vec3(0.0);
    primary.distance = -1.0;
    primary.prev_position = vec3(0.0);
    primary.has_prev = false;
    primary.albedo = vec3(1.0);

    for (uint depth = 0u; depth <= frame.max_bounces; depth++) {
        SceneHit sh = trace_scene(ray, throughput);

        if (depth == 0u) {
            primary.hit = sh.found || sh.absorbed;
            primary.distance = primary.hit ? sh.distance : -1.0;
            if (sh.absorbed) {
                primary.normal = -camera_dir;
                primary.prev_position = camera_pos + camera_dir * sh.distance;
                primary.has_prev = true;
            }
        }
        if (sh.absorbed) break;
        if (!sh.found) {
            radiance += clamp_contribution(throughput * sample_sky(ray.d), depth);
            break;
        }
        ShadingInfo s = get_shading(ray, sh.hit);

        if (depth == 0u) {
            primary.normal = s.normal;
            primary.has_prev = true;
            primary.albedo = (s.diffuse_albedo + s.fresnel_0) * throughput;
            if (sh.crossed_portal) {
                // Seen through a portal: reproject the unfolded point (exact for static portals).
                primary.prev_position = camera_pos + camera_dir * sh.distance;
            } else {
                Instance inst = instances[sh.hit.instance];
                primary.prev_position = xform_point(inst.prev_o2w, xform_point(inst.w2o, s.position));
            }
        }

        // Emission found by BSDF sampling, MIS-weighted against next event estimation.
        // Light sampling never reaches through portals, so those paths keep full weight.
        if (s.emission_luminance > 0.0) {
            float weight = 1.0;
            if (depth > 0u && !sh.crossed_portal) {
                weight = power_heuristic(prev_bsdf_pdf, emissive_light_pdf(s, prev_position));
            }
            radiance += clamp_contribution(throughput * s.emission * weight, depth);
        }

        if (depth == frame.max_bounces) break;

        vec3 direct = vec3(0.0);
        if (frame.emissive_count > 0u) direct += sample_emissive(s, rng);
        for (uint i = 0u; i < frame.punctual_count; i++) {
            direct += sample_punctual(s, punctual_lights[i], rng);
        }
        radiance += clamp_contribution(throughput * direct, depth + 1u);

        vec3 wi = sample_brdf(s, rand2(rng));
        float cos_in = dot(s.normal, wi);
        if (cos_in <= 0.0 || dot(s.geo_normal, wi) <= 0.0) break;
        float pdf = get_brdf_density(s, wi);
        if (!(pdf > 1e-8)) break;
        throughput *= brdf(s, wi) * cos_in / pdf;

        if (depth >= 2u) { // Russian roulette
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (rand(rng) > p) break;
            throughput /= p;
        }
        if (any(isnan(throughput)) || any(isinf(throughput))) break;

        prev_bsdf_pdf = pdf;
        prev_position = s.position;
        ray.o = offset_origin(s, wi);
        ray.d = wi;
    }
    return radiance;
}

vec3 debug_view(Ray ray, out Primary primary) {
    vec3 throughput = vec3(1.0);
    const vec3 camera_dir = ray.d;
    const vec3 camera_pos = ray.o;
    SceneHit sh = trace_scene(ray, throughput);
    primary.hit = sh.found || sh.absorbed;
    primary.distance = primary.hit ? sh.distance : -1.0;
    primary.normal = -camera_dir;
    primary.prev_position = camera_pos + camera_dir * sh.distance;
    primary.has_prev = primary.hit;
    primary.albedo = vec3(1.0);
    if (frame.debug_mode == DEBUG_TRAVERSAL) {
        float x = clamp(float(sh.hit.steps) / 128.0, 0.0, 1.0);
        return vec3(x, x * x, 1.0 - x) * x;
    }
    if (sh.absorbed) return vec3(0.0);
    if (!sh.found) return sample_sky(ray.d) * throughput;
    ShadingInfo s = get_shading(ray, sh.hit);
    primary.normal = s.normal;
    if (frame.debug_mode == DEBUG_NORMALS) return (s.normal * 0.5 + 0.5) * throughput;
    return (s.diffuse_albedo + s.fresnel_0 * 0.0) * throughput;
}

Ray camera_ray(vec2 pixel) {
    // Godot's RD projection already accounts for the flipped Vulkan framebuffer y axis.
    vec2 ndc = pixel / vec2(frame.size) * 2.0 - 1.0;
    vec4 view = frame.inv_projection * vec4(ndc, 0.5, 1.0);
    view.xyz /= view.w;
    Ray r;
    r.o = frame.cam_to_world[3].xyz;
    r.d = normalize(mat3(frame.cam_to_world) * normalize(view.xyz));
    return r;
}

// ----------------------------------- ENTRY -----------------------------------

// Where this pixel's primary hit (or, for the sky, the view direction) was on screen last frame,
// as a pixel coordinate (pixel centres at integers). The sample was taken at `pixel` (jittered);
// its screen motion is applied to the pixel centre, so a static view reprojects to exactly the
// same pixel instead of resampling (and slowly blurring) the history every frame.
vec4 compute_motion(const Primary primary, const vec3 view_dir, const vec2 pixel) {
    vec4 clip;
    float expected = -1.0;
    if (primary.hit) {
        if (!primary.has_prev) return vec4(0.0);
        clip = frame.prev_view_proj * vec4(primary.prev_position, 1.0);
        expected = length(primary.prev_position - frame.prev_cam_pos.xyz);
    } else {
        clip = frame.prev_view_proj * vec4(view_dir, 0.0); // sky: direction only
    }
    if (clip.w <= 1e-6) return vec4(0.0);
    vec2 ndc = clip.xy / clip.w;
    vec2 prev_pixel = (ndc * 0.5 + 0.5) * vec2(frame.size); // same convention as `pixel`
    vec2 p = floor(pixel) + (prev_pixel - pixel); // pixel corner + motion
    if (!(all(greaterThan(p, vec2(-1.0))) && all(lessThan(p, vec2(frame.size))))) return vec4(0.0);
    return vec4(p, expected, 1.0);
}

void pt_main() {
    ivec2 pos = ivec2(PIXEL_ID);
    if (pos.x >= frame.size.x || pos.y >= frame.size.y) return;

    uint rng = pcg_hash(uint(pos.x) + pcg_hash(uint(pos.y) + pcg_hash(frame.frame_index)));

    vec3 color = vec3(0.0);
    Primary primary;
    vec3 view_dir = vec3(0.0, 0.0, -1.0);
    vec2 first_pixel = vec2(pos) + 0.5;
    uint spp = max(frame.samples_per_pixel, 1u);
    for (uint i = 0u; i < spp; i++) {
        Primary p;
        vec3 c;
        if (frame.debug_mode == DEBUG_NONE) {
            vec2 pixel = vec2(pos) + rand2(rng);
            Ray ray = camera_ray(pixel);
            if (i == 0u) {
                view_dir = ray.d;
                first_pixel = pixel;
            }
            c = path_trace(ray, rng, p);
        } else {
            Ray ray = camera_ray(vec2(pos) + 0.5);
            if (i == 0u) view_dir = ray.d;
            c = debug_view(ray, p);
        }
        if (i == 0u) primary = p;
        if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
        color += c;
    }
    color /= float(spp);

    imageStore(frame_color, pos, vec4(color, 1.0));
    imageStore(frame_motion, pos, compute_motion(primary, view_dir, first_pixel));
    imageStore(frame_albedo, pos, vec4(primary.albedo, 1.0));
    imageStore(gbuffer_out, pos, vec4(primary.normal, primary.hit ? primary.distance : -1.0));
}
