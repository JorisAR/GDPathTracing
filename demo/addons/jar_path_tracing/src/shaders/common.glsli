// Shared declarations for the path tracer. Mirrors src/path_tracing/gpu_types.h and
// src/path_tracing/path_tracing_effect.h (FrameData). Keep both sides in sync.

#define M_PI 3.141592653589793
#define INF 1e30

#define DEBUG_NONE 0u
#define DEBUG_NORMALS 1u
#define DEBUG_ALBEDO 2u
#define DEBUG_TRAVERSAL 3u


#define TLAS_LEAF 0xFFFFFFFFu
#define INSTANCE_FLAG_EMISSIVE 1u
#define MATERIAL_FLAG_EMISSION_MULTIPLY 1u
#define MATERIAL_FLAG_NORMAL_DIRECTX 2u

#define LIGHT_DIRECTIONAL 0u
#define LIGHT_OMNI 1u
#define LIGHT_SPOT 2u

struct BVHNode {
    vec3 aabb_min;
    uint left_first;
    vec3 aabb_max;
    uint tri_count;
};

struct TLASNode {
    vec3 aabb_min;
    uint left;
    vec3 aabb_max;
    uint right;
};

struct Triangle {
    vec4 v0; // w = 1: alpha tested (some instance's material has alpha below one)
    vec4 e1;
    vec4 e2;
};

struct TriangleData {
    vec3 n0;
    uint surface;
    vec4 n1; // w = tangent.x
    vec4 n2; // w = tangent.y
    vec2 uv0;
    vec2 uv1;
    vec2 uv2;
    vec2 tangent_z_sign; // x = tangent.z, y = bitangent sign (object space, per triangle)
};

struct Material {
    vec4 albedo;
    vec4 emission; // rgb radiance, a = luminance
    float metallic;
    float roughness;
    int albedo_texture;
    uint flags;
    vec4 uv_scale_offset;
    int emission_texture; // -1 = none
    float emission_energy;
    int roughness_texture; // layers in data_textures, -1 = none
    int metallic_texture;
    int normal_texture;
    uint channels;         // bits 0-2 roughness channel, 3-5 metallic channel (Godot TextureChannel)
    float alpha_cutoff;    // > 0 alpha scissor threshold, < 0 stochastic alpha, 0 = opaque
    float normal_scale;
};

struct Instance {
    vec4 o2w[3];      // rows of the object -> world affine matrix
    vec4 w2o[3];      // rows of the world -> object affine matrix
    vec4 prev_o2w[3]; // object -> world of the previous frame (motion vectors)
    uint bvh_root;
    uint material_offset;
    uint triangle_offset;
    uint flags;
    uint emissive_offset; // first entry of this instance in emissive_triangles (emissive instances)
    uint pad0;
    uint pad1;
    uint pad2;
};

struct EmissiveTriangle {
    vec3 v0;          // world space
    float power;      // luminance(emission) * world area
    vec3 e1;          // world space v1 - v0
    float alias_prob; // alias table: keep this entry with this probability...
    vec3 e2;          // world space v2 - v0
    uint alias;       // ...otherwise use this one
    vec2 uv0;
    vec2 uv1;
    vec2 uv2;
    uint material;
    uint pad;
};

struct PunctualLight {
    vec3 position;
    uint type;
    vec3 direction;
    float radius;
    vec3 color;
    float range;
    float spot_cos_outer;
    float spot_cos_inner;
    float attenuation;
    float pad;
};

struct Portal {
    vec4 w2l[3];      // world -> portal local (portal plane is local z = 0, front faces +z)
    vec4 teleport[3]; // world -> world transform applied to rays entering through the front
    vec4 tint;        // rgb multiplier applied when passing through
    vec2 half_size;
    uint linked;      // 0 = no destination, behaves as a black surface
    uint pad;
};

// ----------------------------------- BINDINGS -----------------------------------

layout(set = 0, binding = 0, std140) uniform FrameData {
    mat4 cam_to_world;
    mat4 inv_projection;
    mat4 prev_view_proj; // previous frame projection * view, for reprojection
    vec4 prev_cam_pos;
    vec4 sky_top;     // rgb * energy
    vec4 sky_horizon; // rgb * energy
    vec4 ground;      // rgb * energy
    ivec2 size;
    uint frame_index;
    uint pad1;
    uint max_bounces;
    uint samples_per_pixel;
    uint instance_count;
    uint emissive_count;
    uint punctual_count;
    float emissive_total_power;
    float firefly_clamp;
    uint debug_mode;
    uint flags;
    uint portal_count;
    uint max_portal_hops;
    uint pad0;
    vec4 env_params; // energy, rotation (radians about +Y), integral of the sampling weights
    ivec4 env_size;  // width, height
} frame;

#define FLAG_RESTIR 1u      // the trace pass splits off a reusable GI sample for restir.glsl
#define FLAG_ENVIRONMENT 2u // an environment map replaces the gradient sky (importance sampled)
#define FLAG_RESTIR_DI 4u   // direct light from emitters / environment at x1 comes from restir_di.glsli

#ifndef RESTIR_PASS
// Outputs of the tracing pass. Accumulation happens afterwards in resolve.glsl; keeping this
// pass free of history reads keeps the (large) tracing kernel small.
layout(set = 0, binding = 1, rgba32f) uniform restrict writeonly image2D frame_color;  // rgb this frame's radiance
layout(set = 0, binding = 2, rgba32f) uniform restrict writeonly image2D frame_motion; // xy previous pixel, z expected previous distance (-1 sky), w 1 = valid
layout(set = 0, binding = 3, rgba32f) uniform restrict writeonly image2D frame_albedo; // rgb primary albedo
layout(set = 0, binding = 4, rgba32f) uniform restrict writeonly image2D gbuffer_out;  // xyz normal, w distance (-1 = sky)
// ReSTIR GI inputs (only written with FLAG_RESTIR). See restir.glsli.
layout(set = 0, binding = 5, rgba32f) uniform restrict writeonly image2D gi_hit_out;    // primary hit: xyz world position, w packed geometric normal (< 0 = no reuse)
layout(set = 0, binding = 6, rgba32f) uniform restrict writeonly image2D gi_sample_out; // xyz secondary hit x2, w source pdf (0 = no sample)
layout(set = 0, binding = 7, rgba32f) uniform restrict writeonly image2D gi_radiance_out; // rgb radiance leaving x2 towards x1, w packed normal at x2
// ReSTIR DI: what the BSDF ray from x1 found, if it is a light (an emitter or the environment).
layout(set = 0, binding = 8, rgba32f) uniform restrict writeonly image2D di_hit_a_out; // xyz light point (or direction), w light sampling pdf (< 0: none)
layout(set = 0, binding = 9, rgba32f) uniform restrict writeonly image2D di_hit_b_out; // rgb emitted radiance, w packed light normal (-1: environment)
// Material at a reusable primary hit (half floats), so the ReSTIR passes skip texture lookups:
// x = diffuse.rg, y = (diffuse.b, GGX alpha), z = F0.rg, w = (F0.b, 0).
layout(set = 0, binding = 10, rgba32ui) uniform restrict writeonly uimage2D surface_out;
#endif

layout(set = 1, binding = 0, std430) restrict readonly buffer BVHNodes { BVHNode bvh_nodes[]; };
layout(set = 1, binding = 1, std430) restrict readonly buffer Triangles { Triangle triangles[]; };
layout(set = 1, binding = 2, std430) restrict readonly buffer TriangleDatas { TriangleData triangle_data[]; };
layout(set = 1, binding = 3, std430) restrict readonly buffer Materials { Material materials[]; };
layout(set = 1, binding = 4, std430) restrict readonly buffer InstanceMaterials { uint instance_materials[]; };
layout(set = 1, binding = 5, std430) restrict readonly buffer Instances { Instance instances[]; };
layout(set = 1, binding = 6, std430) restrict readonly buffer TLASNodes { TLASNode tlas_nodes[]; };
layout(set = 1, binding = 7, std430) restrict readonly buffer EmissiveTriangles { EmissiveTriangle emissive_triangles[]; };
layout(set = 1, binding = 8, std430) restrict readonly buffer PunctualLights { PunctualLight punctual_lights[]; };
layout(set = 1, binding = 9, std430) restrict readonly buffer Portals { Portal portals[]; };
// Environment importance sampling: an alias table with one (keep probability as float bits, alias)
// pair per texel, row major. See src/path_tracing/environment.h.
layout(set = 1, binding = 11, std430) restrict readonly buffer EnvironmentAlias { uvec2 env_alias[]; };

layout(set = 2, binding = 0) uniform sampler2DArray albedo_textures; // sRGB colors (albedo, emission)
layout(set = 2, binding = 1) uniform sampler2DArray data_textures;   // linear: roughness, metallic, normals
layout(set = 2, binding = 2) uniform sampler2D environment_map;      // equirect, linear RGB

// ----------------------------------- HELPERS -----------------------------------

struct Ray {
    vec3 o;
    vec3 d;
};

struct Hit {
    float t;
    vec2 bary;
    uint instance;
    uint triangle;
    uint steps;
};

vec3 xform_point(const vec4 rows[3], vec3 p) {
    return vec3(dot(rows[0], vec4(p, 1.0)), dot(rows[1], vec4(p, 1.0)), dot(rows[2], vec4(p, 1.0)));
}

vec3 xform_vector(const vec4 rows[3], vec3 v) {
    return vec3(dot(rows[0].xyz, v), dot(rows[1].xyz, v), dot(rows[2].xyz, v));
}

// Transforms an object space normal to world space using the inverse transpose,
// i.e. transpose(world_to_object) * n. Correct under non-uniform scale.
vec3 xform_normal(const vec4 w2o[3], vec3 n) {
    return n.x * w2o[0].xyz + n.y * w2o[1].xyz + n.z * w2o[2].xyz;
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec2 material_uv(const Material m, const TriangleData td, vec2 bary) {
    vec2 uv = td.uv0 * (1.0 - bary.x - bary.y) + td.uv1 * bary.x + td.uv2 * bary.y;
    return uv * m.uv_scale_offset.xy + m.uv_scale_offset.zw;
}

// ----------------------------------- RANDOM -----------------------------------

uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word >> 8u) * (1.0 / 16777216.0);
}

// Uniform integer in [0, n) (modulo bias at most n / 2^32).
uint rand_index(inout uint state, uint n) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return ((word >> 22u) ^ word) % max(n, 1u);
}

vec2 rand2(inout uint state) {
    return vec2(rand(state), rand(state));
}

// Alpha test: false if the hit at `bary` on `triangle` of `instance` is (this frame) transparent.
// alpha = albedo color alpha * albedo texture alpha. A positive cutoff is an alpha scissor
// threshold; a negative one means stochastic transparency (alpha blend / hash / depth prepass):
// the surface is kept with probability alpha, which converges to the blended result.
bool alpha_test_pass(uint instance, uint triangle, vec2 bary) {
    Instance inst = instances[instance];
    TriangleData td = triangle_data[triangle];
    Material m = materials[instance_materials[inst.material_offset + td.surface]];
    if (m.alpha_cutoff == 0.0) return true;
    float a = m.albedo.a;
    if (m.albedo_texture >= 0)
        a *= textureLod(albedo_textures, vec3(material_uv(m, td, bary), float(m.albedo_texture)), 0.0).a;
    if (m.alpha_cutoff > 0.0) return a >= m.alpha_cutoff;
    // Same point, same frame: same answer (closest and shadow rays agree); new pattern each frame.
    uvec2 q = uvec2(clamp(bary, 0.0, 1.0) * 65535.0);
    uint h = pcg_hash(triangle ^ pcg_hash(q.x | (q.y << 16u)) ^ pcg_hash(frame.frame_index ^ 0x9e3779b9u));
    return float(h >> 8u) * (1.0 / 16777216.0) < a;
}

// Orthonormal basis around n (Duff et al. 2017).
mat3 basis_from_normal(vec3 n) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (s + n.z);
    float b = n.x * n.y * a;
    return mat3(vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x), vec3(b, s + n.y * n.y * a, -n.y), n);
}

vec2 sample_disk(vec2 u) {
    float r = sqrt(u.x);
    float phi = 2.0 * M_PI * u.y;
    return r * vec2(cos(phi), sin(phi));
}

// Octahedral normal encoding (2 x 12 bits) stored as an integer-valued float, exact below 2^24.
// Bit-casting packed integers to floats is not safe in float images: small values are denormals
// that GPUs flush to zero.
float pack_normal(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    uvec2 q = uvec2(round(clamp(e * 0.5 + 0.5, 0.0, 1.0) * 4095.0));
    return float(q.x * 4096u + q.y);
}

vec3 unpack_normal(float f) {
    uint u = uint(f);
    vec2 e = vec2(float(u >> 12u), float(u & 4095u)) / 4095.0 * 2.0 - 1.0;
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 sample_sphere(vec2 u) {
    float z = 1.0 - 2.0 * u.x;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 2.0 * M_PI * u.y;
    return vec3(r * cos(phi), r * sin(phi), z);
}
